@torch.no_grad()
def evaluate_prediction_accuracy(model, tokenizer, tokens, device, max_seq_len=2048):
    """
    无重复统计、上下文连续的准确率计算。
    用于压缩任务，保证 encoder/decoder 对齐。
    tokens: 1D torch.LongTensor, 原文 token 序列
    """
    from collections import Counter
    import torch
    from tqdm import tqdm

    total = 0
    top1_count = 0
    top2_m_count = 0
    topm_n_count = 0
    above_n_count = 0

    worse_token_lens = Counter()
    worst_token_lens = Counter()
    error_analysis_data = []

    tokens = tokens.to(device)
    seq_len = tokens.size(0)

    # 按 max_seq_len 分批做一次前向（因为显存限制）
    # 注意：这里是 sliding over full sequence，保持上下文连续
    rank_list = []
    for start_idx in tqdm(range(0, seq_len - 1, max_seq_len - 1)):
        end_idx = min(start_idx + max_seq_len, seq_len)
        input_ids = tokens[start_idx:end_idx].unsqueeze(0)  # shape: (1, chunk_len)

        outputs = model(input_ids)
        logits = outputs.logits[:, :-1, :]  # (1, chunk_len-1, vocab_size)
        targets = input_ids[:, 1:]  # (1, chunk_len-1)

        # 计算 rank
        for pos in range(logits.shape[1]):
            pred_logits = logits[0, pos]
            true_token = targets[0, pos].item()

            sorted_indices = torch.argsort(pred_logits, descending=True)
            rank = (sorted_indices == true_token).nonzero(as_tuple=True)[0].item() + 1
            tok_len = len(tokenizer.convert_ids_to_tokens([true_token])[0].replace('▁', ''))
            rank_list.append({'rank': rank, 'tok_len': tok_len})

            pred_token_id = sorted_indices[0].item()

            # total += 1
    total = len(rank_list)

    values = [2 ** i for i in range(1, 9)]
    compression_results = {}
    for m in values:
        for n in values:
            if n >= m:
                top1 = sum(1 for r in rank_list if r['rank'] == 1)
                top2_m = sum(1 for r in rank_list if 2 <= r['rank'] <= m)
                topm_n = sum(1 for r in rank_list if m < r['rank'] <= n)
                above_n = sum(1 for r in rank_list if r['rank'] > n)

                compressed_size = total * 2 + top2_m * np.log2(m) + topm_n * np.log2(n) + above_n * 16
                compression_results[(m, n)] = compressed_size

                print(f"(m={m}, n={n}) 压缩大小: {compressed_size:.2f} bits, "
                      f"Top1: {top1 / total:.2%}, Top2~m: {top2_m / total:.2%}, "
                      f"Topm~n: {topm_n / total:.2%}, Above-n: {above_n / total:.2%}")

    # Fine best combination (m, n)
    best_pair = min(compression_results, key=compression_results.get)
    best_size = compression_results[best_pair]

    print("=" * 50)
    print(f"最优组合: m={best_pair[0]}, n={best_pair[1]}")
    print(f"最小压缩大小: {best_size:.2f} bits")
    print("=" * 50)

return {
        "total": total,
        "top1": top1_count,
        "top2_m": top2_m_count,
        "aboven": above_n_count,
        "top1_ratio": top1_count / total,
        "top2_m_ratio": top2_m_count / total,
        "aboven_ratio": above_n_count / total,
        "error_data": error_analysis_data  # 新增
    }



